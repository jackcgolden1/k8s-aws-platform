#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

# Update the OS
apt-get update -y
apt-get upgrade -y -o Dpkg::Options::="--force-confold"

# Log k3s in to ECR using the server's IAM role
snap install aws-cli --classic
ECR_PASSWORD=$(/snap/bin/aws ecr get-login-password --region us-east-1)
mkdir -p /etc/rancher/k3s
cat > /etc/rancher/k3s/registries.yaml <<EOF
configs:
  "${ecr_registry}":
    auth:
      username: AWS
      password: $ECR_PASSWORD
EOF
chmod 600 /etc/rancher/k3s/registries.yaml

# Wait until the server's Kubernetes API is up
until timeout 2 bash -c "</dev/tcp/${server_ip}/6443"; do
  echo "Waiting for server at ${server_ip}..."
  sleep 10
done

# Install k3s as an AGENT and join the server
curl -sfL https://get.k3s.io | K3S_URL="https://${server_ip}:6443" K3S_TOKEN="${k3s_token}" sh -